// Cloudflare Workers (free plan): Workers & Pages -> Create -> Import a repository -> this repo.
// Every push to main deploys. The 4 secrets (ADMIN_PASSWORD, GEMINI_API_KEY, VAXAURA_WP_USER,
// VAXAURA_WP_APP_PASSWORD) are typed in the dashboard (Settings -> Variables and Secrets), never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaxaura-product-drafts",
  "main": "worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "VAXAURA_SITE": "https://vaxaura.com" },
  "observability": { "enabled": true }
}
